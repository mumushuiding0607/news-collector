@echo off
REM ================================================================
REM 风向标AI - 全自动构建并发布到应用市场
REM ================================================================
REM
REM 前置条件:
REM   1. 在小米/华为开发者后台手动创建应用，获取 AppId + 凭证
REM   2. 将凭证填入 .env
REM   3. 确保 backend/main.py 已部署（含 /privacy.html 路由）
REM
REM 用法: 双击运行，或 cmd: publish.bat
REM ================================================================

setlocal enabledelayedexpansion

set "SCRIPT_DIR=%~dp0"
set "PROJECT_ROOT=%~dp0..\news_board_app"

call "%SCRIPT_DIR%load_env.bat"
if errorlevel 1 (
    echo [ERROR] 加载配置失败
    exit /b 1
)

REM 从 metadata.json 读取版本
for /f "delims=" %%v in ('python "%SCRIPT_DIR%get_version.py" version_name') do set "VERSION_NAME=%%v"
for /f "delims=" %%c in ('python "%SCRIPT_DIR%get_version.py" version_code') do set "VERSION_CODE=%%c"

echo ================================================================
echo   风向标AI - 自动发布脚本
echo ================================================================
echo   版本: !VERSION_NAME! (versionCode !VERSION_CODE!)
echo ================================================================
echo.

REM ================================================================
REM Step 1: 构建 APK
REM ================================================================
echo [1/4] 构建 APK...
call "%SCRIPT_DIR%build_app.bat"
if errorlevel 1 (
    echo [ERROR] APK 构建失败，终止发布
    exit /b 1
)
echo [OK] APK 构建完成

REM ================================================================
REM Step 2: 发布到小米应用市场
REM ================================================================
echo.
echo [2/4] 发布到小米应用市场...
if defined MI_APP_ID (
    call :publish_xiaomi
) else (
    echo [SKIP] 未配置小米凭证，跳过
    echo [INFO] 请在 .env 中填写 MI_APP_ID / MI_API_KEY / MI_ACCESS_TOKEN
)

REM ================================================================
REM Step 3: 发布到华为应用市场
REM ================================================================
echo.
echo [3/4] 发布到华为应用市场...
if defined HW_CLIENT_ID (
    call :publish_huawei
) else (
    echo [SKIP] 未配置华为凭证，跳过
    echo [INFO] 请在 .env 中填写 HW_APP_ID / HW_CLIENT_ID / HW_CLIENT_SECRET
)

REM ================================================================
REM Step 4: 完成
REM ================================================================
echo.
echo ================================================================
echo   发布流程完成
echo ================================================================
echo   APK: !PROJECT_ROOT!\build\app\outputs\flutter-apk\app-release.apk
echo.
echo   请前往开发者后台确认审核状态:
echo   小米: https://open.xiaomi.com
echo   华为: https://developer.huawei.com/consumer
echo ================================================================
exit /b 0

REM ================================================================
REM 发布到小米应用市场
REM ================================================================
:publish_xiaomi
echo   AppId: !MI_APP_ID!

set "MI_UPLOAD_URL=https://api.io.mi.com/openapi/developer/v2/app/upload"

echo [INFO] 上传 APK...
curl -X POST "!MI_UPLOAD_URL!" ^
  -H "Content-Type: multipart/form-data" ^
  -H "Authorization: Bearer !MI_ACCESS_TOKEN!" ^
  -F "file=@!PROJECT_ROOT!\build\app\outputs\flutter-apk\app-release.apk" ^
  -F "appId=!MI_APP_ID!" ^
  -F "appVersion=!VERSION_NAME!" ^
  -F "appVersionCode=!VERSION_CODE!" ^
  -F "buildType=release" ^
  -o "!TEMP!\_mi_resp.json" ^
  --max-time 300 ^
  -s

findstr /C:"success" /C:"10000" "!TEMP!\_mi_resp.json" >nul 2>&1
if errorlevel 1 (
    echo   [ERROR] 小米上传失败
    type "!TEMP!\_mi_resp.json"2>nul | findstr /V "WARNING"
) else (
    echo   [OK] APK 已上传到小米，请前往后台提交审核
)
del "!TEMP!\_mi_resp.json"2>nul
exit /b 0

REM ================================================================
REM 发布到华为应用市场
REM ================================================================
:publish_huawei
echo   AppId: !HW_APP_ID!

REM 获取 Access Token
set "HW_TOKEN_URL=https://connect-api.cloud.huawei.com/api/oauth2/v1/token"
echo   [INFO] 获取华为 Access Token...
curl -X POST "!HW_TOKEN_URL!" ^
  -H "Content-Type: application/json" ^
  -d "{\"client_id\":\"!HW_CLIENT_ID!\",\"client_secret\":\"!HW_CLIENT_SECRET!\",\"grant_type\":\"client_credentials\"}" ^
  -o "!TEMP!\_hw_token.json" ^
  --max-time 30 ^
  -s

set "HW_ACCESS_TOKEN="
for /f "usebackq tokens=*" %%t in (`findstr /C:"access_token" "!TEMP!\_hw_token.json"`) do (
    set "line=%%t"
    set "line=!line:*access_token:=!"
    set "line=!line:,=!"
    set "line=!line: =!"
    set "line=!line:\"=!"
    set "HW_ACCESS_TOKEN=!line!"
)

if not defined HW_ACCESS_TOKEN (
    echo   [ERROR] 获取 Token 失败
    del "!TEMP!\_hw_token.json" 2>nul
    exit /b 0
)
echo   [OK] Token 获取成功

REM 上传 APK
set "HW_UPLOAD_URL=https://connect-api.cloud.huawei.com/api/app/v2/upload/file"
echo   [INFO] 上传 APK...
curl -X POST "!HW_UPLOAD_URL!" ^
  -H "Authorization: Bearer !HW_ACCESS_TOKEN!" ^
  -H "client_id: !HW_CLIENT_ID!" ^
  -F "file=@!PROJECT_ROOT!\build\app\outputs\flutter-apk\app-release.apk" ^
  -F "appId=!HW_APP_ID!" ^
  -o "!TEMP!\_hw_resp.json" ^
  --max-time 300 ^
  -s

findstr /C:"success" /C:"200" "!TEMP!\_hw_resp.json" >nul 2>&1
if errorlevel 1 (
    echo   [ERROR] 华为上传失败
) else (
    echo   [OK] APK 已上传到华为，请前往后台提交审核
)

del "!TEMP!\_hw_token.json" 2>nul
del "!TEMP!\_hw_resp.json" 2>nul
exit /b 0
